configuration {
    modi: "run,window,combi";
    icon-theme: "Gruvbox Dark";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " 󰎟  All ";
    display-run: " 󰜎 Run ";
    display-window: " 󱂬  Window";
    sidebar-mode: true;
    font: "JetBrains Mono 12";
    width: 800;
}

@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    bg-col:        @background;
    bg-col-light:  @color0;
    border-col:    @color8;
    selected-col:  @color4;
    blue:          @color4;
    fg-col:        @foreground;
    fg-col2:       @color1;
    grey:          @color8;
}
